# =============================================================================
# .env.production.template
#
# NOTA: Este archivo es solo de referencia.
# El archivo .env.production real es generado AUTOMÁTICAMENTE por:
#   ./scripts/setup-aws-infra.sh
#
# ⚠️  NUNCA agregues Access Keys (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
#     aquí. Las credenciales de AWS se obtienen automáticamente via
#     Cognito Identity Pool (STS AssumeRoleWithWebIdentity).
# =============================================================================

# Cognito User Pool (autenticación web)
VITE_AWS_USER_POOL_ID=YOUR_USER_POOL_ID
VITE_AWS_USER_POOL_CLIENT_ID=YOUR_APP_CLIENT_ID
VITE_AWS_COGNITO_DOMAIN=YOUR_APP_NAME-auth.auth.us-east-1.amazoncognito.com

# Cognito Identity Pool (credenciales temporales para Bedrock/DynamoDB/Translate)
VITE_AWS_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Región y admin
VITE_AWS_REGION=us-east-1
VITE_DEV_ADMIN_EMAIL=admin@example.com

# PayPal Subscription Configuration
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
VITE_PAYPAL_PLAN_MONTHLY=YOUR_PAYPAL_PLAN_MONTHLY_ID
VITE_PAYPAL_PLAN_ANNUAL=YOUR_PAYPAL_PLAN_ANNUAL_ID

# CloudFront domain para servir imágenes de exámenes generadas por IA
VITE_CLOUDFRONT_DOMAIN=YOUR_CLOUDFRONT_DOMAIN
